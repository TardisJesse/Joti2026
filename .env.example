# Copy this file to .env for local Docker development.
POSTGRES_DB=cyberjoti
POSTGRES_USER=cyberjoti
POSTGRES_PASSWORD=change-me
DATABASE_URL=postgresql+psycopg://cyberjoti:change-me@postgres:5432/cyberjoti
REDIS_URL=redis://redis:6379/0
SECRET_KEY=replace-with-a-long-random-value
ACCESS_TOKEN_EXPIRE_MINUTES=480
CORS_ORIGINS=http://localhost:5173
# Railway frontend proxy target: http://backend.railway.internal:8000

